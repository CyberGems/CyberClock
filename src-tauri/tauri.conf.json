{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CyberClock",
  "mainBinaryName": "CyberClock",
  "version": "1.15.0",
  "identifier": "com.cybergems.cyberclock",
  "build": {
    "frontendDist": "../src",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CyberClock",
        "width": 1024,
        "height": 768,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "visible": false,
        "url": "main/index.html"
      },
      {
        "label": "mini",
        "title": "CyberClock Mini",
        "width": 260,
        "height": 48,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "url": "mini/index.html"
      },
      {
        "label": "menu",
        "title": "CyberClock Menu",
        "width": 292,
        "height": 430,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "url": "mini/menu.html"
      },
      {
        "label": "tray_menu",
        "title": "CyberClock Tray Menu",
        "width": 290,
        "height": 600,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "url": "tray/menu.html"
      },
      {
        "label": "about",
        "title": "About CyberClock",
        "width": 740,
        "height": 535,
        "minWidth": 600,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "center": true,
        "skipTaskbar": true,
        "url": "about/index.html"
      },
      {
        "label": "mini_tip",
        "title": "CyberClock Mini Tip",
        "width": 280,
        "height": 180,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "url": "mini/tip.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://api.github.com https://github.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/alarm-sounds/**",
          "$EXE/data/alarm-sounds/**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/CyberGems/CyberClock/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3ODVFOUU4MUE0MDMxMApSV1FRQTZTQm5sNTRCQlMxZ0RwblplTVVRZmQrUng4OEFkU2d4QStab2RpSlZ4a0Nwb1prREJMdwo=",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "CyberGems",
    "resources": [
      "bin/open-taskbar-settings.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "installer.nsh",
        "template": "nsis/installer.nsi",
        "sidebarImage": "nsis/installerSidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "Spanish"
        ]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

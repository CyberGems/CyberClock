{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CyberClock",
  "version": "1.0.3",
  "identifier": "com.cybergems.cyberclock",
  "build": {
    "frontendDist": "../src",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CyberClock",
        "width": 1024,
        "height": 768,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "url": "main/index.html"
      },
      {
        "label": "mini",
        "title": "CyberClock Mini",
        "width": 260,
        "height": 48,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "url": "mini/index.html"
      },
      {
        "label": "menu",
        "title": "CyberClock Menu",
        "width": 270,
        "height": 500,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "url": "mini/menu.html"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/CyberGems/CyberClock/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3ODVFOUU4MUE0MDMxMApSV1FRQTZTQm5sNTRCQlMxZ0RwblplTVVRZmQrUng4OEFkU2d4QStab2RpSlZ4a0Nwb1prREJMdwo=",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "CyberGems",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}